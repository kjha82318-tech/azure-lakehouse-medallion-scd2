{
  "name": "pl_enterprise_lakehouse_orchestrator",
  "properties": {
    "description": "Azure Data Factory Pipeline to orchestrate Medallion Lakehouse Ingestion & SCD Type 2 PySpark Transformations.",
    "activities": [
      {
        "name": "Copy_API_to_ADLS_Raw",
        "type": "Copy",
        "dependsOn": [],
        "policy": {
          "timeout": "0.01:00:00",
          "retry": 3,
          "retryIntervalInSeconds": 30
        },
        "typeProperties": {
          "source": {
            "type": "RestSource",
            "httpRequestTimeout": "00:01:40",
            "requestInterval": "00.00:00:00.010"
          },
          "sink": {
            "type": "JsonSink",
            "storeSettings": {
              "type": "AzureBlobFSWriteSettings"
            },
            "formatSettings": {
              "type": "JsonWriteSettings"
            }
          },
          "enableStaging": false
        },
        "inputs": [
          {
            "referenceName": "ds_rest_api_source",
            "type": "DatasetReference"
          }
        ],
        "outputs": [
          {
            "referenceName": "ds_adls_gen2_raw_json",
            "type": "DatasetReference"
          }
        ]
      },
      {
        "name": "Execute_Bronze_Ingestion",
        "type": "DatabricksNotebook",
        "dependsOn": [
          {
            "activity": "Copy_API_to_ADLS_Raw",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "notebookPath": "/Shared/Lakehouse/01_bronze_ingestion"
        },
        "linkedServiceName": {
          "referenceName": "ls_azure_databricks_cluster",
          "type": "LinkedServiceReference"
        }
      },
      {
        "name": "Execute_Silver_Cleaning",
        "type": "DatabricksNotebook",
        "dependsOn": [
          {
            "activity": "Execute_Bronze_Ingestion",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "notebookPath": "/Shared/Lakehouse/02_silver_cleaning"
        },
        "linkedServiceName": {
          "referenceName": "ls_azure_databricks_cluster",
          "type": "LinkedServiceReference"
        }
      },
      {
        "name": "Execute_Gold_SCD2_Merge",
        "type": "DatabricksNotebook",
        "dependsOn": [
          {
            "activity": "Execute_Silver_Cleaning",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "notebookPath": "/Shared/Lakehouse/03_gold_dimensional_scd2"
        },
        "linkedServiceName": {
          "referenceName": "ls_azure_databricks_cluster",
          "type": "LinkedServiceReference"
        }
      }
    ],
    "annotations": [
      "MedallionArchitecture",
      "SCD_Type_2",
      "AzureDataLakeGen2"
    ]
  }
}
